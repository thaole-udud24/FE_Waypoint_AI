  "fontFamily": {
    "sans": "'Inter', 'Noto Sans', system-ui, -apple-system, sans-serif",
    "numeric": "'Inter', system-ui, sans-serif"
  },
  "fontSize": {
    "caption": "12px",
    "label": "13px",
    "body": "15px",
    "cardHeading": "16px",
    "sectionHeading": "20px",
